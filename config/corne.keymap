#include <behaviors.dtsi>
#include <behaviors/num_word.dtsi>  // vendored zmk-auto-layer
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

// mouse speed, tuned for 3840x2160 (must come before pointing.h; ZMK defaults: 600 / 10)
#define ZMK_POINTING_DEFAULT_MOVE_VAL 900
#define ZMK_POINTING_DEFAULT_SCRL_VAL 10
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

#include "zmk-helpers/helper.h"        // vendored zmk-helpers
#include "zmk-helpers/key-labels/42.h"
#include "de_mac.h"

/*                              KEY POSITIONS

  ╭─────────────────────────╮ ╭─────────────────────────╮
  │ LT5 LT4 LT3 LT2 LT1 LT0 │ │ RT0 RT1 RT2 RT3 RT4 RT5 │
  │ LM5 LM4 LM3 LM2 LM1 LM0 │ │ RM0 RM1 RM2 RM3 RM4 RM5 │
  │ LB5 LB4 LB3 LB2 LB1 LB0 │ │ RB0 RB1 RB2 RB3 RB4 RB5 │
  ╰───────────╮ LH2 LH1 LH0 │ │ RH0 RH1 RH2 ╭───────────╯
              ╰─────────────╯ ╰─────────────╯ */

// Order matters: a layer only overrides the ones below it. ZMK_LAYER calls below
// must appear in this same order.
#define DEF 0
#define COMBO 1   // DEF + symbol combos (toggle: NUM + right thumb outer key)
#define NAV 2
#define NUM 3
#define SYM 4
#define NOHRM 5   // toggle: SYM + right thumb outer key

#define XXX &none
#define ___ &trans

#define QUICK_TAP_MS 175

/* Global behavior settings */

&sk {  // sticky-key
    release-after-ms = <900>;
    quick-release;             // no double capitalization when rolling keys
};

&sl {  // sticky-layer
    ignore-modifiers;          // allow chording sticky mods & layers
};

&lt {  // layer-tap
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <QUICK_TAP_MS>;
};

/* Homerow mods: only resolve as hold when a key on the other hand (or a thumb) is pressed */

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LM0 LM1 LM2 LM3 LM4 LB0 LB1 LB2 LB3 LB4
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RM0 RM1 RM2 RM3 RM4 RB0 RB1 RB2 RB3 RB4
#define THUMBS LH2 LH1 LH0 RH0 RH1 RH2

#define MAKE_HRM(NAME, HOLD, TAP, TRIGGER_POS) \
    ZMK_HOLD_TAP(NAME, \
        flavor = "balanced"; \
        tapping-term-ms = <200>; \
        quick-tap-ms = <QUICK_TAP_MS>; \
        require-prior-idle-ms = <100>; \
        bindings = <HOLD>, <TAP>; \
        hold-trigger-key-positions = <TRIGGER_POS>; \
        hold-trigger-on-release; \
    )
MAKE_HRM(hml, &kp, &kp, KEYS_R THUMBS)  // left-hand HRMs
MAKE_HRM(hmr, &kp, &kp, KEYS_L THUMBS)  // right-hand HRMs

/* Nav cluster: tap = short action, long-press = long action */

#define MT_CORE \
    flavor = "tap-preferred"; \
    tapping-term-ms = <220>; \
    quick-tap-ms = <220>; \
    hold-trigger-key-positions = <0>;

&mt { MT_CORE };
ZMK_HOLD_TAP(mt_home, bindings = <&masked_home>, <&kp>; MT_CORE)
ZMK_HOLD_TAP(mt_end, bindings = <&masked_end>, <&kp>; MT_CORE)

// mask CTRL when holding left/right to avoid accidental jumps to beginning/end of document
ZMK_MOD_MORPH(masked_home, bindings = <&kp HOME>, <&kp HOME>; mods = <(MOD_LCTL)>;)
ZMK_MOD_MORPH(masked_end, bindings = <&kp END>, <&kp END>; mods = <(MOD_LCTL)>;)

#define NAV_LEFT  &mt_home 0   LEFT    // tap: left  | long-tap: beginning of line
#define NAV_RIGHT &mt_end 0    RIGHT   // tap: right | long-tap: end       of line
#define NAV_UP    &mt LC(HOME) UP      // tap: up    | long-tap: beginning of document
#define NAV_DOWN  &mt LC(END)  DOWN    // tap: down  | long-tap: end       of document

/* Smart num: tap = num-word | double-tap = sticky num layer | hold = num layer */

#define SMART_NUM &smart_num NUM 0
ZMK_HOLD_TAP(smart_num,
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <QUICK_TAP_MS>;
    bindings = <&mo>, <&num_dance>;
)
ZMK_TAP_DANCE(num_dance,
    tapping-term-ms = <200>;
    bindings = <&num_word NUM>, <&sl NUM>;
)

/* Symbol combos (COMBO layer only), layout from urob's zmk-config

   press two neighbouring keys at once (letters as typed with the German layout):

     vertical, top + home row        vertical, home + bottom row
       W+S @   E+D #   R+F $   T+G %     S+X `   D+C \   F+V =   G+B ~
       Z+H ^   U+J +   I+K *   O+L &     H+N _   J+M -   K+, /   L+. |

     horizontal, right hand
       U+I {   I+O }      J+K (  shift: <      M+, [   ,+. ]
                          K+L )  shift: >

   J+K / K+L sit on homerow mods, so holding them gives the mods instead
   (J+K: shift+ctrl, K+L: ctrl+alt). */

#define COMBO_TERM_FAST 18  // horizontal: must hit almost together
#define COMBO_TERM_SLOW 30  // vertical: two fingers, a bit more slack
#define COMBO_IDLE_FAST 150 // no combos right after typing (avoids misfires)
#define COMBO_IDLE_SLOW 50
#define COMBO_LAYERS COMBO

// hold-tap combos: tap = symbol, hold = mods (8-argument ZMK_COMBO)
#define ZMK_COMBO_8(NAME, TAP, KEYPOS, LAYERS, TERM, IDLE, HOLD, SIDE) \
    MAKE_HRM(hm_combo_ ## NAME, &kp, TAP, SIDE THUMBS) \
    ZMK_COMBO_6(NAME, &hm_combo_ ## NAME HOLD 0, KEYPOS, LAYERS, TERM, IDLE)

ZMK_MOD_MORPH(lpar_lt, mods = <(MOD_LSFT|MOD_RSFT)>; bindings = <&kp DE_LPAR>, <&kp DE_LT>;)
ZMK_MOD_MORPH(rpar_gt, mods = <(MOD_LSFT|MOD_RSFT)>; bindings = <&kp DE_RPAR>, <&kp DE_GT>;)

/* Horizontal - right hand */
ZMK_COMBO(lbrc,  &kp DE_LBRC,  RT1 RT2, COMBO_LAYERS, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(rbrc,  &kp DE_RBRC,  RT2 RT3, COMBO_LAYERS, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(lpar,  &lpar_lt,     RM1 RM2, COMBO_LAYERS, COMBO_TERM_FAST, COMBO_IDLE_FAST, LS(RCTRL), KEYS_L)
ZMK_COMBO(rpar,  &rpar_gt,     RM2 RM3, COMBO_LAYERS, COMBO_TERM_FAST, COMBO_IDLE_FAST, LA(RCTRL), KEYS_L)
ZMK_COMBO(lbkt,  &kp DE_LBKT,  RB1 RB2, COMBO_LAYERS, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(rbkt,  &kp DE_RBKT,  RB2 RB3, COMBO_LAYERS, COMBO_TERM_FAST, COMBO_IDLE_FAST)

/* Vertical - left hand */
ZMK_COMBO(at,    &kp DE_AT,    LT3 LM3, COMBO_LAYERS, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(hash,  &kp DE_HASH,  LT2 LM2, COMBO_LAYERS, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(dllr,  &kp DE_DLLR,  LT1 LM1, COMBO_LAYERS, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(prcnt, &kp DE_PRCNT, LT0 LM0, COMBO_LAYERS, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(grave, &kp DE_GRAVE, LM3 LB3, COMBO_LAYERS, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(bslh,  &kp DE_BSLH,  LM2 LB2, COMBO_LAYERS, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(equal, &kp DE_EQUAL, LM1 LB1, COMBO_LAYERS, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(tilde, &kp DE_TILDE, LM0 LB0, COMBO_LAYERS, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)

/* Vertical - right hand */
ZMK_COMBO(caret, &kp DE_CARET, RT0 RM0, COMBO_LAYERS, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(plus,  &kp DE_PLUS,  RT1 RM1, COMBO_LAYERS, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(star,  &kp DE_STAR,  RT2 RM2, COMBO_LAYERS, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(amps,  &kp DE_AMPS,  RT3 RM3, COMBO_LAYERS, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(under, &kp DE_UNDER, RM0 RB0, COMBO_LAYERS, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(minus, &kp DE_MINUS, RM1 RB1, COMBO_LAYERS, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(fslh,  &kp DE_FSLH,  RM2 RB2, COMBO_LAYERS, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(pipe,  &kp DE_PIPE,  RM3 RB3, COMBO_LAYERS, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)

/* Mouse keys, based on @caksoylar's config */

&mmv {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <500>;
    delay-ms = <0>;
};

&msc {
    acceleration-exponent = <0>;
    time-to-max-speed-ms = <300>;
    delay-ms = <0>;
};

/ {
    zip_scroll_scaler: zip_scroll_scaler {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
        track-remainders;
    };
};

&mmv_input_listener {
    warp { layers = <NAV>; input-processors = <&zip_xy_scaler 3 1>; };       // 3x faster on NAV
};

&msc_input_listener {
    warp { layers = <NAV>; input-processors = <&zip_scroll_scaler 2 1>; };   // 2x faster on NAV
};

#define U_MS_U &mmv MOVE_UP
#define U_MS_D &mmv MOVE_DOWN
#define U_MS_L &mmv MOVE_LEFT
#define U_MS_R &mmv MOVE_RIGHT
#define U_WH_U &msc SCRL_UP
#define U_WH_D &msc SCRL_DOWN
#define U_WH_L &msc SCRL_LEFT
#define U_WH_R &msc SCRL_RIGHT

/* Keymap */

ZMK_LAYER(base,
//╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &kp TAB       &kp Q         &kp W         &kp E         &kp R         &kp T           &kp Y         &kp U         &kp I         &kp O         &kp P         &kp LBKT
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp ESC       &hml LGUI A   &hml LALT S   &hml LCTRL D  &hml LSHFT F  &kp G           &kp H         &hmr LSHFT J  &hmr RCTRL K  &hmr LALT L   &hmr LGUI SEMI &kp SQT
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp CAPS      &kp Z         &kp X         &kp C         &kp V         &kp B           &kp N         &kp M         &kp COMMA     &kp DOT       &kp FSLH      &kp LSHFT
//╰─────────────┴─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────┴─────────────╯
                                              &mo SYM       SMART_NUM     &lt NAV SPACE   &kp RET       &kp BSPC      &mo SYM
//                                          ╰─────────────┴─────────────┴─────────────╯ ╰─────────────┴─────────────┴─────────────╯
)

// Same as base (all transparent); only exists so the symbol combos can be toggled on/off.
ZMK_LAYER(combo,
//╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    ___           ___           ___           ___           ___           ___             ___           ___           ___           ___           ___           ___
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    ___           ___           ___           ___           ___           ___             ___           ___           ___           ___           ___           ___
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    ___           ___           ___           ___           ___           ___             ___           ___           ___           ___           ___           ___
//╰─────────────┴─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────┴─────────────╯
                                              ___           ___           ___             ___           ___           ___
//                                          ╰─────────────┴─────────────┴─────────────╯ ╰─────────────┴─────────────┴─────────────╯
)

ZMK_LAYER(nav,
//╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    ___           ___           U_WH_D        U_MS_U        U_WH_U        ___             ___           &kp PG_DN     &kp PG_UP     ___           ___           &sys_reset
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    ___           U_WH_L        U_MS_L        U_MS_D        U_MS_R        U_WH_R          NAV_LEFT      NAV_DOWN      NAV_UP        NAV_RIGHT     ___           ___
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR    &sys_reset      &kp C_PREV    &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT    &kp C_PP      &kp C_MUTE
//╰─────────────┴─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────┴─────────────╯
                                              ___           ___           ___             &mkp LCLK     &mkp RCLK     ___
//                                          ╰─────────────┴─────────────┴─────────────╯ ╰─────────────┴─────────────┴─────────────╯
)

ZMK_LAYER(num,
//╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &kp N1        &kp N2        &kp N3        &kp N4        &kp N5        &kp N6          &kp N7        &kp N8        &kp N9        &kp N0        &kp MINUS     &kp EQUAL
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    ___           ___           ___           ___           ___           ___             ___           ___           ___           ___           ___           ___
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp F1        &kp F2        &kp F3        &kp F4        &kp F5        &kp F6          &kp F7        &kp F8        &kp F9        &kp F10       &kp F11       &kp F12
//╰─────────────┴─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────┴─────────────╯
                                              ___           ___           ___             ___           ___           &tog COMBO
//                                          ╰─────────────┴─────────────┴─────────────╯ ╰─────────────┴─────────────┴─────────────╯
)

ZMK_LAYER(sym,
//╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &kp EXCL      &kp AT        &kp HASH      &kp DOLLAR    &kp PERCENT   &kp CARET       &kp AMPS      &kp STAR      &kp LPAR      &kp RPAR      &kp UNDER     &kp PLUS
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp DE_EURO   &sk LGUI      &sk LALT      &sk LCTRL     &sk LSHFT     ___             &kp LS(LA(N7)) &kp LA(N5)   &kp LA(N6)    ___           &kp TILDE2    &kp NUHS
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp LS(GRAVE) &kp GRAVE     &kp LA(N)     &kp NUBS      ___           ___             &kp LA(N7)    &kp LA(N8)    &kp LA(N9)    &kp LA(L)     ___           &kp RBKT
//╰─────────────┴─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────┴─────────────╯
                                              ___           ___           ___             ___           ___           &tog NOHRM
//                                          ╰─────────────┴─────────────┴─────────────╯ ╰─────────────┴─────────────┴─────────────╯
)

ZMK_LAYER(nohrm,
//╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮ ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    ___           XXX           &kp Q         &kp W         &kp E         &kp R           &kp Y         &kp U         &kp I         &kp O         &kp P         ___
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    ___           &kp LSHIFT    &kp A         &kp S         &kp D         &kp F           &kp H         &kp J         &kp K         &kp L         &kp SEMI      ___
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    ___           &kp LCTRL     &kp X         &kp C         &kp V         &kp B           &kp N         &kp M         &kp COMMA     &kp DOT       &kp FSLH      ___
//╰─────────────┴─────────────┴─────────────┼─────────────┼─────────────┼─────────────┤ ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────┴─────────────╯
                                              ___           SMART_NUM     &kp SPACE       &kp RET       &kp BSPC      &tog NOHRM
//                                          ╰─────────────┴─────────────┴─────────────╯ ╰─────────────┴─────────────┴─────────────╯
)
