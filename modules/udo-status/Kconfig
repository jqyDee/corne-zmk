config UDO_STATUS
    bool "Show udo time-tracking status on the peripheral's nice!view"
    default n
    depends on ZMK_SPLIT
    # The peripheral draws its own status screen (stock one disabled there)
    select LV_FONT_MONTSERRAT_14 if ZMK_DISPLAY && !ZMK_SPLIT_ROLE_CENTRAL
    select LV_FONT_MONTSERRAT_16 if ZMK_DISPLAY && !ZMK_SPLIT_ROLE_CENTRAL
    select LV_USE_IMG if ZMK_DISPLAY && !ZMK_SPLIT_ROLE_CENTRAL
    select LV_USE_CANVAS if ZMK_DISPLAY && !ZMK_SPLIT_ROLE_CENTRAL
